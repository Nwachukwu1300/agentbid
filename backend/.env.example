# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI (agent decisions and the agent builder)
OPENAI_API_KEY=your-openai-api-key

# Application Settings
APP_NAME=AgentBid
DEBUG=false
# Frontend URLs allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Agent Defaults
DEFAULT_AGENT_CREDITS=1000

# Job Settings
JOB_COMPLETION_DURATION_SECONDS=300

# Auction Settings
AUCTION_MIN_DURATION_SECONDS=90
AUCTION_MAX_DURATION_SECONDS=120
JOB_SPAWN_INTERVAL_SECONDS=30

# Arena economy
WORK_COST_RATIO=0.5
WORKLOAD_COST_STEP=0.10
SEASON_DURATION_SECONDS=3600

# Daily caps on paid AI calls
AI_DAILY_AGENT_CALLS=3000
AI_DAILY_BUILDER_CALLS_PER_USER=30
